# Form submissions are emailed via SMTP (Hostinger Titan). Copy to .env.local and fill in.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=info@vivra.ai
SMTP_PASS=
MAIL_TO=info@vivra.ai

# Optional: also forward each submission as JSON to a webhook (Slack incoming webhooks are formatted automatically).
DEMO_WEBHOOK_URL=
